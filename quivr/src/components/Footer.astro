---
// src/components/Footer.astro
import SocialLink from "./Socials.astro"; // Adjust path if needed

interface SocialItem {
  href: string;
  ariaLabel: string;
  path: string;
}

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  companyName?: string;
  logoSrc?: string;
  logoAlt?: string;
  tagline?: string;
  phoneNumber?: string;
  emailAddress?: string;
  navigationLinks?: NavLink[];
}

const {
  companyName = "Vivid Real",
  logoSrc = "https://api.iconify.design/lucide:aperture.svg?color=%23818cf8",
  logoAlt = "Company Logo",
  tagline = "Crafting high-fidelity, performance-first visual web experiences.",
  phoneNumber = "+1 (555) 019-2834",
  emailAddress = "hello@vividreal.com",
  navigationLinks = [
    { label: "About Us", href: "#" },
    { label: "Features", href: "#" },
    { label: "Work", href: "#" },
    { label: "Privacy Policy", href: "#" },
  ],
} = Astro.props;
---

<footer class="w-full bg-slate-950 text-slate-200 border-t border-white/10 pt-16 pb-12 px-6">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col md:flex-row flex-wrap justify-between gap-10">
      
      <!-- Company Brand & Tagline Column -->
      <div class="max-w-sm space-y-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 p-2 border border-white/10 backdrop-blur-md">
            <img src={logoSrc} alt={logoAlt} class="h-full w-full object-contain" />
          </div>
          <span class="text-xl font-bold tracking-tight text-white">{companyName}</span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          {tagline}
        </p>
      </div>

      <!-- Quick Navigation Links -->
      <div class="space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Navigation</span>
        <ul class="space-y-2.5 text-sm font-medium">
          {navigationLinks.map((link) => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info & Social Links Column -->
      <div class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Connect</span>
        <div class="space-y-1.5 text-sm text-slate-400">
          <p class="font-medium text-white">{phoneNumber}</p>
          <p><a href={`mailto:${emailAddress}`} class="hover:underline hover:text-white transition-colors">{emailAddress}</a></p>
        </div>

        <!-- Integrated Socials Component -->
        <div class="pt-1">
          <div class="flex items-center gap-3">
              <SocialLink></SocialLink>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>&copy; {new Date().getFullYear()} {companyName}. All rights reserved.</p>
      <p>Designed for the Vivid Real Theme.</p>
    </div>
  </div>
</footer>
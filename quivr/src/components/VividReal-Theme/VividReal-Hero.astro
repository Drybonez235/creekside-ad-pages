---
// src/components/HeroFullImage.astro
interface Props {
  title?: string;
  subtitle?: string;
  DesktopBGImage?: string;
  mobileBGImage?: string;
  primaryCtaText?: string;
  primaryCtaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}
//desktop image should be deal Dimensions: 2560 × 1440 px or 1920 × 1080 px Target Aspect Ratio: 16:9 Max File Size: Under 250 KB (compressed as WebP or AVIF)
//Ideal Dimensions: 1080 × 1920 px or 828 × 1792 px Target Aspect Ratio: 9:16 Max File Size: Under 100 KB (compressed as WebP or AVIF)

const {
  title = "Build Boldly with Astro & Tailwind",
  subtitle = "Create stunning, high-performance web experiences with flexible, modern component patterns.",
  DesktopBGImage = "/landscape-16:9.jpg",
  mobileBGImage = "/landscape-9:16.jpg",
  primaryCtaText = "Get Started",
  primaryCtaLink = "#",
  secondaryCtaText = "View Components",
  secondaryCtaLink = "#",
} = Astro.props;
---

<section class="relative min-h-dvh w-full flex items-center justify-center overflow-hidden text-white">
  <!-- Background Image with LCP optimization -->
  <picture>
  <!-- Mobile / Phone Image -->
  <source media="(max-width: 767px)" srcset={mobileBGImage} />
  <!-- Desktop / Laptop Image -->
  <img 
    src={DesktopBGImage}
    alt="" 
    class="absolute inset-0 -z-20 h-full w-full object-cover" 
    loading="eager" 
    decoding="async" 
  />
</picture>

  <!-- Dark Overlay for text legibility -->
 <!-- backdrop-blur-[2px] for blur -->
  <div class="absolute inset-0 -z-10 bg-slate-950/60"></div>

  <!-- Hero Content -->
  <div class="relative z-10 mx-auto max-w-4xl px-6 py-24 text-center">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl">
      {title}
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-200 sm:text-xl">
      {subtitle}
    </p>

    <!-- Call to Actions -->
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      {
        primaryCtaText && (
          <a
            href={primaryCtaLink}
            class="w-full rounded-lg bg-indigo-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg transition-colors hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 sm:w-auto"
          >
            {primaryCtaText}
          </a>
        )
      }

      {
        secondaryCtaText && (
          <a
            href={secondaryCtaLink}
            class="w-full rounded-lg bg-white/10 px-6 py-3.5 text-base font-semibold text-white backdrop-blur-md transition-colors hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"
          >
            {secondaryCtaText}
          </a>
        )
      }
    </div>
  </div>
</section>
---
// src/components/SocialProofGrid.astro
interface Testimonial {
  name: string;
  role?: string;
  image: string;
  review: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  testimonials?: Testimonial[];
}

const {
  eyebrow = "Social Proof",
  heading = "Loved by Visual Creators Worldwide",
  description = "See what leading designers, developers, and creative directors say about building with Vivid Real.",
  testimonials = [
    {
      name: "Alex Rivera",
      role: "Design Lead",
      image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=800&auto=format&fit=crop",
      review: "Vivid Real elevated our visual identity instantly. The crisp contrast and performance are unmatched.",
    },
    {
      name: "Samantha Wu",
      role: "Senior Engineer",
      image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=800&auto=format&fit=crop",
      review: "Building with these components in Astro saved us weeks of dev time without losing design precision.",
    },
    {
      name: "David Korb",
      role: "Creative Director",
      image: "https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=800&auto=format&fit=crop",
      review: "The image masking and loading speeds give our web projects a luxurious, high-end feel.",
    },
    {
      name: "Elena Rostova",
      role: "Brand Strategist",
      image: "https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?q=80&w=800&auto=format&fit=crop",
      review: "Our conversion rate jumped 24% after re-launching with the Vivid Real layout system.",
    },
    {
      name: "Marcus Vance",
      role: "UI Architect",
      image: "https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?q=80&w=800&auto=format&fit=crop",
      review: "Extremely clean Tailwind integration. The zero-margin flip cards feel super crisp.",
    },
    {
      name: "Clara Bennett",
      role: "Founder",
      image: "https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=800&auto=format&fit=crop",
      review: "The seamless edge blends and dynamic contrast make our product photos look unbelievable.",
    },
  ],
} = Astro.props;

// Ensure max 6 items
const activeTestimonials = testimonials.slice(0, 4);
---

<section class="w-full bg-slate-950 px-6 py-20 md:py-28 text-white overflow-hidden">
  <div class="mx-auto max-w-7xl flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
    
    <!-- Left Column: Heading & Description (40% width on desktop) -->
    <div class="w-full lg:w-[40%] space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">
        {eyebrow}
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-100">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed pt-2">
        {description}
      </p>
    </div>

    <!-- Right Column: Seamless Seamless Zero-Margin Flip Grid (60% width on desktop) -->
    <div class="w-full lg:w-[60%] grid grid-cols-2 sm:grid-cols-3 gap-0 border border-white/10 rounded-2xl overflow-hidden bg-slate-900 shadow-2xl">
      {
        activeTestimonials.map((item) => (
          <div 
            tabindex="0"
            class="group relative h-64 sm:h-72 w-full cursor-pointer [perspective:1000px] outline-none"
          >
            <!-- 3D Card Inner Wrapper -->
            <div class="relative h-full w-full transition-transform duration-1200 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)] group-focus:[transform:rotateY(180deg)]">
              
              <!-- Front Side: Image + Overlay Name -->
              <div class="absolute inset-0 h-full w-full [backface-visibility:hidden]">
                <img
                  src={item.image}
                  alt={item.name}
                  class="h-full w-full object-cover object-center"
                  loading="lazy"
                  decoding="async"
                />
                <!-- Gradient overlay for text readability on front -->
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent flex flex-col justify-end p-4">
                  <h3 class="text-base font-bold text-white leading-tight">
                    {item.name}
                  </h3>
                  {item.role && (
                    <span class="text-xs text-indigo-300/90">
                      {item.role}
                    </span>
                  )}
                </div>
              </div>

              <!-- Back Side: Review Content -->
              <div class="absolute inset-0 h-full w-full bg-indigo-950 p-6 flex flex-col justify-center text-center text-white [transform:rotateY(180deg)] [backface-visibility:hidden] border border-white/10">
                <p class="text-xs sm:text-sm font-medium leading-relaxed italic text-slate-100">
                  "{item.review}"
                </p>
                <div class="mt-4 pt-3 border-t border-white/10">
                  <span class="text-xs font-bold text-indigo-300 block">
                    {item.name}
                  </span>
                  {item.role && (
                    <span class="text-[10px] text-slate-300 block">
                      {item.role}
                    </span>
                  )}
                </div>
              </div>

            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>
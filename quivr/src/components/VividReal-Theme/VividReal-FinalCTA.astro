---
// src/components/FinalCtaVividReal.astro
interface Props {
  imageSrc?: string;
  imageAlt?: string;
  eyebrow?: string;
  heading?: string;
  description?: string;
  primaryCtaText?: string;
  primaryCtaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}

const {
  imageSrc = "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1200&auto=format&fit=crop",
  imageAlt = "Vivid Real visual artwork",
  eyebrow = "Ready to Transform Your Workflow?",
  heading = "Bring Your Digital Experiences to Life Today",
  description = "Join thousands of creators building high-performance, visually stunning web experiences with the Vivid Real layout system.",
  primaryCtaText = "Get Started Free",
  primaryCtaLink = "#",
  secondaryCtaText = "Explore Documentation",
  secondaryCtaLink = "#",
} = Astro.props;
---

<section class="relative min-h-screen w-full bg-slate-100 text-slate-900 flex flex-col md:flex-row overflow-hidden">
  
  <!-- Left Column: Full-Height 50% Image Container (Desktop) -->
  <div class="w-full md:w-[50%] relative self-stretch min-h-[350px] md:min-h-screen overflow-hidden bg-slate-200">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="h-full w-full object-cover object-center transition-transform duration-700 hover:scale-105"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Right Column: Full 50% Text & Actions -->
  <div class="w-full md:w-[50%] px-8 py-16 sm:px-12 md:px-16 lg:px-24 flex flex-col justify-center">
    <div class="max-w-xl">
      <span class="text-xs font-bold uppercase tracking-widest text-indigo-600">
        {eyebrow}
      </span>

      <h2 class="mt-3 text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.1]">
        {heading}
      </h2>

      <p class="mt-6 text-base sm:text-xl text-slate-600 leading-relaxed">
        {description}
      </p>

      <!-- Action Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        {
          primaryCtaText && (
            <a
              href={primaryCtaLink}
              class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-8 py-4 text-base font-semibold text-white shadow-lg transition-all duration-200 hover:bg-indigo-700 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            >
              {primaryCtaText}
            </a>
          )
        }

        {
          secondaryCtaText && (
            <a
              href={secondaryCtaLink}
              class="inline-flex items-center justify-center rounded-xl bg-white px-8 py-4 text-base font-semibold text-slate-700 border border-slate-300 transition-colors duration-200 hover:bg-slate-50 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-400"
            >
              {secondaryCtaText}
            </a>
          )
        }
      </div>
    </div>
  </div>

</section>
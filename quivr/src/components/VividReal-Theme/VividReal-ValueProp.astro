---
// src/components/ValueAddVividReal.astro

//To get the cleanest blend with a right-side alpha mask and ensure high performance, follow these guidelines for your Vivid Real side-image:

// Ideal Aspect Ratio & Dimensions
// Dimensions: 1200 × 1600 px or 1440 × 1920 px
// Aspect Ratio: Vertical/Portrait orientation (3:4 or 9:16)
// Key Detail: Because the container spans 40% screen width but 100% viewport height on desktop, portrait images minimize cropping loss compared to landscape photos.
// Visual Subject & Composition
// Subject Placement: Keep key subjects (people, products, or main focal points) on the left or center of the photo.
// Edge Composition: The right 30–40% of the image will fade out completely into transparency. Avoid placing critical visual details near the right edge.
// Tonal Contrast: Darker or medium-toned backgrounds in the photo blend more naturally into dark gradient backgrounds (like slate-950/indigo-950).


interface Concept {
  number: string;
  heading: string;
  subtext: string;
}

interface Props {
  sideImage?: string;
  sectionTitle?: string;
  concepts?: Concept[];
}

const {
  sideImage = "/valueAdd-image3:4.jpeg",
  sectionTitle = "The Vivid Real Difference",
  concepts = [
    {
      number: "01",
      heading: "Hyper-Realistic Color Rendering",
      subtext: "Experience high-contrast visuals engineered to mirror natural light dynamics, delivering breathtaking clarity without over-saturation.",
    },
    {
      number: "02",
      heading: "Uncompromising Detail & Depth",
      subtext: "Every frame captures razor-sharp textures and rich shadow fidelity, giving your digital assets an immersive, tangible presence.",
    },
    {
      number: "03",
      heading: "Instantaneous Edge Performance",
      subtext: "Ultra-optimized media pipelines deliver full-resolution imagery in milliseconds, combining raw aesthetic power with lightning speed.",
    },
  ],
} = Astro.props;
---

<section class="relative min-h-dvh w-full bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white flex flex-col md:flex-row overflow-hidden">
  
  <!-- Desktop Side Image: 40% width with a seamless mask blend -->
  <div class="hidden md:block md:w-[40%] relative self-stretch overflow-hidden mask-[linear-gradient(to_right,black_80%,transparent_80%)] [-webkit-mask-image:linear-gradient(to_right,black_40%,transparent_100%)]">
    <img
      src={sideImage}
      alt="Vivid Real visual sample"
      class="h-full w-full object-cover object-left"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Content Area: 60% width on desktop, 100% on mobile -->
  <div class="w-full md:w-[60%] px-6 py-16 md:px-16 md:py-24 flex flex-col justify-center relative z-10">
    <!-- Section Header -->
    <div class="max-w-2xl mb-12 md:mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Vivid Real Theme</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight mt-2 bg-gradient-to-r from-white via-slate-100 to-indigo-200 bg-clip-text text-transparent">
        {sectionTitle}
      </h2>
    </div>

    <!-- 3 Value Add Concepts -->
    <div class="max-w-3xl space-y-10 md:space-y-12">
      {
        concepts.map((concept) => (
          <div class="group relative flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-8 border-b border-white/10 pb-10 last:border-0 last:pb-0">
            <span class="text-2xl sm:text-3xl font-mono font-bold text-indigo-400/80">
              {concept.number}
            </span>
            <div class="space-y-2">
              <h3 class="text-xl sm:text-2xl font-bold text-white">
                {concept.heading}
              </h3>
              <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
                {concept.subtext}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
---
// src/components/WhoWeAre.astro
interface TeamMember {
  name: string;
  role: string;
  bio: string;
  image: string;
}

interface Props {
  eyebrow?: string;
  sectionTitle?: string;
  members?: TeamMember[];
}

const {
  eyebrow = "Who We Are",
  sectionTitle = "The Minds Behind Vivid Real",
  members = [
    {
      name: "Elena Rostova",
      role: "Creative Director",
      bio: "Pioneering high-fidelity visual aesthetics with over a decade of experience leading global design teams and digital brand strategies.",
      image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=800&auto=format&fit=crop",
    },
    {
      name: "Marcus Chen",
      role: "Lead Architect",
      bio: "Engineers ultra-fast media pipelines and rendering architectures, ensuring uncompromised visual quality at lightning execution speed.",
      image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=800&auto=format&fit=crop",
    },
    {
      name: "Sophia Vance",
      role: "Head of Product",
      bio: "Focuses on bridging human-centered design with modern web capabilities, turning complex component patterns into intuitive tools.",
      image: "https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=800&auto=format&fit=crop",
    },
  ],
} = Astro.props;
---

<section class="w-full bg-slate-950 px-6 py-20 md:py-28 text-white overflow-hidden">
  <div class="mx-auto max-w-7xl">
    <!-- Section Header -->
    <div class="max-w-2xl mb-12 md:mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">{eyebrow}</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight mt-2 text-slate-100">
        {sectionTitle}
      </h2>
    </div>

    <!-- 33% Width Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      {
        members.map((member) => (
          <div class="group flex flex-col h-full bg-slate-900/40 rounded-2xl overflow-hidden border border-white/5 hover:border-white/10 transition-all duration-300">
            
            <!-- Top Half: Image Container (Fixed Half-Height Ratio) -->
            <div class="relative h-64 sm:h-72 w-full overflow-hidden bg-slate-900">
              <img
                src={member.image}
                alt={member.name}
                class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-80"></div>
            </div>

            <!-- Lower Half: Content Area -->
            <div class="flex flex-col flex-grow p-6 sm:p-8">
              <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-indigo-300 transition-colors">
                {member.name}
              </h3>
              
              <span class="text-xs font-semibold uppercase tracking-wider text-indigo-400 mt-1">
                {member.role}
              </span>

              <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed flex-grow">
                {member.bio}
              </p>
            </div>

          </div>
        ))
      }
    </div>
  </div>
</section>